---
import CardTech from "./CardTech.astro";

type Technology = {
  image: string;
  title: string;
  tag: string;
};

const technologies: Technology[] = [
  {
    image: "https://i.postimg.cc/gJ1DQ0b0/226777.png",
    title: "Java",
    tag: "Lenguaje",
  },
  {
    image: "/public/imgs/stack/brand.png",
    title: "SpringBoot",
    tag: "Framework",
  },
  {
    image: "/public/imgs/stack/reactive-spring-boot.png",
    title: "Webflux",
    tag: "Framework",
  },
  {
    image: "/public/imgs/stack/Postgresql_logo.webp",
    title: "PostgreSQL",
    tag: "Base de datos",
  },
  {
    image: "/public/imgs/stack/dynamodb_logo.jpg",
    title: "DynamoDB",
    tag: "Base de datos",
  },
  {
    image: "/public/imgs/stack/aws-color.png",
    title: "AWS",
    tag: "Cloud",
  },
  {
    image: "/public/imgs/stack/terraform-icon-tew8r4clf5ocvoyj0o05j.webp",
    title: "Terraform",
    tag: "IaC",
  },
  {
    image: "/public/imgs/stack/docker-logo.png",
    title: "Docker",
    tag: "Contenedores",
  },
];
---

<script>
  import { gsap } from "gsap";
  import { scrambleTitles } from "../scripts/scrambleTitles";

  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  scrambleTitles("#container-text-2");

  gsap.fromTo(
    "#tech-cards .card",
    {
      opacity: 0,
      y: 100,
    },
    {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.2,
      scrollTrigger: {
        trigger: "#tech-cards",
        start: "top 70%",
        end: "bottom 20%",
        scrub: 1.5,
      },
    },
  );
</script>

<section id="stack" class="text-black dark:text-white">
  <div
    id="container-text-2"
    class="w-[80vw] lg:w-[700px] font-semibold leading-tight mb-12 mt-12"
  >
    <h2 class="w-11/12 text-5xl lg:text-[80px] opacity-50 title-2">Acerca</h2>
    <h2 class="w-11/12 text-5xl lg:text-[80px] text-start lg:text-end title-2">
      De mi stack
    </h2>
  </div>
  <div
    id="tech-cards"
    class="md:w-10/12 xl:w-full m-auto grid grid-cols-2 gap-5 md:gap-y-12 sm:gap-x-12 xl:gap-x-8 lg:grid-cols-3 xl:grid-cols-4"
  >
    {
      technologies.map((tech, i) => {
        return (
          <div class="card">
            <CardTech image={tech.image} title={tech.title} tag={tech.tag} />
          </div>
        );
      })
    }
  </div>
</section>
<style>
  #stack {
    width: 90%;
    margin: 0 auto;
  }

  @media screen and (min-width: 1600px) {
    #stack {
      width: 80%;
    }
  }
</style>
