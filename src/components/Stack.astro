---
import CardTech from "./CardTech.astro";

type Technology = {
  image: string;
  title: string;
  tag: string;
};

const technologies: Technology[] = [
  {
    image: "https://i.postimg.cc/gJ1DQ0b0/226777.png",
    title: "Java",
    tag: "Lenguaje",
  },
  {
    image: "/imgs/stack/brand.png",
    title: "SpringBoot",
    tag: "Framework",
  },
  {
    image: "/imgs/stack/reactive-spring-boot.png",
    title: "Webflux",
    tag: "Framework",
  },
  {
    image: "/imgs/stack/Postgresql_logo.webp",
    title: "PostgreSQL",
    tag: "Base de datos",
  },
  {
    image: "/imgs/stack/dynamodb_logo.jpg",
    title: "DynamoDB",
    tag: "Base de datos",
  },
  {
    image: "/imgs/stack/aws-color.png",
    title: "AWS",
    tag: "Cloud",
  },
  {
    image: "/imgs/stack/terraform-icon-tew8r4clf5ocvoyj0o05j.webp",
    title: "Terraform",
    tag: "IaC",
  },
  {
    image: "/imgs/stack/docker-logo.png",
    title: "Docker",
    tag: "Contenedores",
  },
];
---

<script>
  import { gsap } from "gsap";
  import { scrambleTitles } from "../scripts/scrambleTitles";

  scrambleTitles("#container-text-2");

  if (window.matchMedia("(hover: hover)").matches) {
    gsap.utils.toArray<HTMLElement>("#tech-cards .card").forEach((card) => {
      const logo = card.querySelector(".card-logo");
      gsap.set(card, { transformPerspective: 800 });

      const rotX = gsap.quickTo(card, "rotationX", {
        duration: 0.4,
        ease: "power3",
      });
      const rotY = gsap.quickTo(card, "rotationY", {
        duration: 0.4,
        ease: "power3",
      });
      const logoX = gsap.quickTo(logo, "x", { duration: 0.4, ease: "power3" });
      const logoY = gsap.quickTo(logo, "y", { duration: 0.4, ease: "power3" });

      card.addEventListener("mouseenter", () => {
        gsap.to(card, { y: -8, duration: 0.3, ease: "power2.out" });
      });

      card.addEventListener("mousemove", (e) => {
        const { left, top, width, height } = card.getBoundingClientRect();
        const x = (e.clientX - left) / width - 0.5;
        const y = (e.clientY - top) / height - 0.5;

        rotY(x * 12);
        rotX(-y * 12);
        logoX(x * 16);
        logoY(y * 16);
      });

      card.addEventListener("mouseleave", () => {
        gsap.to(card, { y: 0, duration: 0.3, ease: "power2.out" });
        rotX(0);
        rotY(0);
        logoX(0);
        logoY(0);
      });
    });
  }
</script>

<section id="stack" class="text-black dark:text-white">
  <div
    id="container-text-2"
    class="w-[80vw] lg:w-[700px] font-semibold leading-tight mb-12 mt-12"
  >
    <h2 class="w-11/12 text-5xl lg:text-[80px] opacity-50 title-2">Acerca</h2>
    <h2 class="w-11/12 text-5xl lg:text-[80px] text-start lg:text-end title-2">
      De mi stack
    </h2>
  </div>
  <div
    id="tech-cards"
    class="md:w-10/12 xl:w-full m-auto grid grid-cols-2 gap-3 sm:gap-5 md:gap-y-12 sm:gap-x-12 xl:gap-x-8 lg:grid-cols-3 xl:grid-cols-4"
  >
    {
      technologies.map((tech, i) => {
        return (
          <div class="card min-w-0">
            <CardTech image={tech.image} title={tech.title} tag={tech.tag} />
          </div>
        );
      })
    }
  </div>
</section>
<style>
  #stack {
    width: 90%;
    margin: 0 auto;
  }

  @media screen and (min-width: 1600px) {
    #stack {
      width: 80%;
    }
  }
</style>
