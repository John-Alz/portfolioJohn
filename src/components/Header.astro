---
import Location from "./Location.astro";
import { IoMenu, IoClose } from "react-icons/io5";
---

<script>
  import { gsap } from "gsap";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";

  gsap.registerPlugin(ScrollToPlugin);

  const btnOpen = document.querySelector("#btn-open");
  const btnClose = document.querySelector("#btn-close");
  const section = document.querySelector(".active");

  btnOpen?.addEventListener("click", () => {
    section?.classList.toggle("inactive");
    console.log("llegue");
  });

  btnClose?.addEventListener("click", () => {
    section?.classList.toggle("inactive");
    console.log("llegue");
  });

  const links = document.querySelectorAll<HTMLAnchorElement>(
    'header a[href^="#"]',
  );

  links.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const target = link.getAttribute("href") ?? "#home";

      section?.classList.add("inactive");

      gsap.to(window, {
        duration: 1.2,
        scrollTo: target === "#home" ? 0 : { y: target, offsetY: 20 },
        ease: "power3.inOut",
      });
    });
  });
</script>

<header class="flex flex-col justify-center items-center">
  <div class="hidden xl:flex flex-col items-center">
    <h2 class="text-black dark:text-white mt-4 mb-4 text-3xl font-bold">
      John
    </h2>
    <nav class="hidden xl:flex xl:h-14">
      <ul
        class="group flex gap-2 items-center rounded-full bg-white dark:bg-blackAbout text-grayv1 text-lg"
      >
        <li
          class="bg-black text-white flex items-center dark:bg-white dark:text-black h-full px-5 rounded-full ease-in duration-300 group-has-[li:hover]:bg-[transparent] group-has-[li:hover]:text-grayv2 dark:group-has-[li:hover]:bg-[transparent] dark:group-has-[li:hover]:text-grayv1 hover:!bg-black hover:!text-white dark:hover:!bg-white dark:hover:!text-black"
        >
          <a href="#home">Inicio</a>
        </li>
        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#about">Sobre mi</a>
        </li>
        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#stack">Habilidades</a>
        </li>
        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#projects">Proyectos</a>
        </li>
        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#experience">Experiencia</a>
        </li>
        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#studies">Estudios</a>
        </li>

        <li
          class="flex items-center text-grayv2 dark:text-grayv1 h-full px-5 rounded-full hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black ease-in duration-300"
        >
          <a href="#contact">Contacto</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Header mobile -->
  <div class="xl:hidden w-11/12 flex justify-between items-center mb-4">
    <div>
      <h2 class="text-black dark:text-white mt-4 mb-4 text-5xl font-bold">
        John
      </h2>
    </div>
    <div>
      <Location />
    </div>
    <div class="relative dark:text-white">
      <button id="btn-open" class="flex items-center"
        ><IoMenu size={60} /></button
      >
    </div>
    <div class="bg-white dark:bg-blackAbout active inactive">
      <div
        class="w-11/12 m-auto flex justify-between text-5xl md:text-7xl text-black dark:text-white"
      >
        <ul class="flex flex-col gap-12">
          <li><a href="#home">Inicio</a></li>
          <li><a href="#about">Sobre mi</a></li>
          <li><a href="#stack">Habilidades</a></li>
          <li><a href="#projects">Proyectos</a></li>
          <li><a href="#experience">Experiencia</a></li>
          <li><a href="#studies">Estudios</a></li>
          <li><a href="#contact">Contacto</a></li>
        </ul>
        <div id="btn-close" class="dark:text-white">
          <IoClose size={60} />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .active {
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    padding-top: 16px;
    z-index: 20;
  }

  .light {
    background: #f3f3f3;
  }
  .inactive {
    display: none;
  }
</style>
