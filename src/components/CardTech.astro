---
const { image, title, tag } = Astro.props;
---

<div
  class="w-full h-[140px] sm:h-[180px] md:h-[280px] xl:h-[300px] flex flex-col justify-end bg-white dark:bg-blackAbout rounded-2xl"
>
  <div class="flex flex-col justify-center items-center">
    <img
      class="card-logo w-[40px] sm:w-[50px] md:w-[80px] xl:w-[114px] rounded-xl md:pb-10"
      src={image}
      alt={title}
    />
  </div>

  <div class="flex flex-col gap-1.5 sm:gap-2 md:flex-row justify-between items-center p-3 sm:p-4">
    <h2 class="text-xs sm:text-sm lg:text-xl font-semibold truncate max-w-full">{title}</h2>
    <p class="text-grayv2 border border-grayv2 rounded-full py-1 px-3 sm:py-2 sm:px-4 text-[10px] sm:text-xs whitespace-nowrap">
      {tag}
    </p>
  </div>
</div>
